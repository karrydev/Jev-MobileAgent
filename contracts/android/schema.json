{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jev-mobile-agent://contracts/android/v1/schema.json",
  "title": "Jev-MobileAgent Android observation extension v1",
  "$defs": {
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": {"type": "integer"},
        "top": {"type": "integer"},
        "right": {"type": "integer"},
        "bottom": {"type": "integer"}
      }
    },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "integer"},
        "y": {"type": "integer"}
      }
    },
    "insets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": {"type": "integer", "minimum": 0},
        "top": {"type": "integer", "minimum": 0},
        "right": {"type": "integer", "minimum": 0},
        "bottom": {"type": "integer", "minimum": 0}
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_enabled", "can_observe", "reason"],
      "properties": {
        "service_enabled": {"type": "boolean"},
        "can_observe": {"type": "boolean"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "rotation"],
      "properties": {
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "rotation": {"type": "integer", "minimum": 0, "maximum": 3},
        "system_bar_insets": {"$ref": "#/$defs/insets"},
        "window_offset": {"$ref": "#/$defs/offset"},
        "content_width_px": {"type": "integer", "minimum": 1},
        "content_height_px": {"type": "integer", "minimum": 1}
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_state", "capture_count", "upload_count", "missing_reason"],
      "properties": {
        "capture_state": {"type": "string", "enum": ["NOT_REQUESTED", "CAPTURED", "UNAVAILABLE"]},
        "capture_count": {"type": "integer", "minimum": 0},
        "upload_count": {"type": "integer", "minimum": 0},
        "missing_reason": {"type": ["string", "null"]},
        "screenshot_id": {"type": ["string", "null"]}
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "android_schema_version", "task_id", "device_id",
        "screenshot_id", "observation_id", "observation_version", "capture_type",
        "captured_at", "width_px", "height_px", "png_base64", "capture_count",
        "upload_count", "missing_reason"
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "android_schema_version": {"type": "string", "const": "1.0"},
        "task_id": {"type": "string"},
        "device_id": {"type": "string"},
        "screenshot_id": {"type": "string", "minLength": 1},
        "observation_id": {"type": "string", "minLength": 1},
        "observation_version": {"type": "integer", "minimum": 1},
        "capture_type": {"type": "string", "enum": ["BEFORE", "AFTER"]},
        "captured_at": {"type": "string", "minLength": 1},
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "png_base64": {"type": "string", "minLength": 0},
        "capture_count": {"type": "integer", "minimum": 1},
        "upload_count": {"type": "integer", "minimum": 0},
        "missing_reason": {"type": ["string", "null"]}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "parent_node_id",
        "class_name",
        "package_name",
        "text",
        "content_description",
        "state_description",
        "view_id_resource_name",
        "enabled",
        "visible_to_user",
        "clickable",
        "focusable",
        "focused",
        "selected",
        "scrollable",
        "editable",
        "bounds",
        "child_node_ids"
      ],
      "properties": {
        "node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
        "parent_node_id": {"type": ["string", "null"]},
        "class_name": {"type": "string"},
        "package_name": {"type": "string"},
        "text": {"type": "string"},
        "content_description": {"type": "string"},
        "state_description": {"type": "string"},
        "view_id_resource_name": {"type": "string"},
        "enabled": {"type": "boolean"},
        "visible_to_user": {"type": "boolean"},
        "clickable": {"type": "boolean"},
        "focusable": {"type": "boolean"},
        "focused": {"type": "boolean"},
        "selected": {"type": "boolean"},
        "scrollable": {"type": "boolean"},
        "editable": {"type": "boolean"},
        "bounds": {"$ref": "#/$defs/bounds"},
        "child_node_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id",
        "window_type",
        "title",
        "package_name",
        "active",
        "focused",
        "layer",
        "bounds",
        "root_node_id"
      ],
      "properties": {
        "window_id": {"type": "integer", "minimum": 0},
        "window_type": {"type": "integer", "minimum": 0},
        "title": {"type": "string"},
        "package_name": {"type": "string"},
        "active": {"type": "boolean"},
        "focused": {"type": "boolean"},
        "layer": {"type": "integer", "minimum": 0},
        "bounds": {"$ref": "#/$defs/bounds"},
        "root_node_id": {"type": ["string", "null"]}
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "android_schema_version",
        "task_id",
        "device_id",
        "client_name",
        "capabilities"
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "android_schema_version": {"type": "string", "const": "1.0"},
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "device_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "client_name": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "recovery_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["durable_action_journal_then_server_intent_then_effect_v1"]
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "android_schema_version",
        "task_id",
        "observation_id",
        "device_id",
        "observation_version",
        "captured_at",
        "page_state",
        "availability",
        "unavailable_reason",
        "permission",
        "screen",
        "windows",
        "nodes",
        "root_node_ids",
        "capabilities"
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "android_schema_version": {"type": "string", "const": "1.0"},
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "observation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
        "device_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "observation_version": {"type": "integer", "minimum": 1},
        "captured_at": {"type": "string", "minLength": 1},
        "page_state": {"type": "string", "enum": ["observed", "empty", "unavailable"]},
        "availability": {
          "type": "string",
          "enum": ["AVAILABLE", "EMPTY_TREE", "PERMISSION_UNAVAILABLE", "DISCONNECTED"]
        },
        "unavailable_reason": {"type": ["string", "null"]},
        "permission": {"$ref": "#/$defs/permission"},
        "screen": {"$ref": "#/$defs/screen"},
        "windows": {"type": "array", "items": {"$ref": "#/$defs/window"}},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "root_node_ids": {"type": "array", "items": {"type": "string"}},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "visual": {"$ref": "#/$defs/visual"}
      }
    },
    "latest_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "android_schema_version",
        "device_id",
        "connection_status",
        "is_current",
        "received_at",
        "observation"
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "android_schema_version": {"type": "string", "const": "1.0"},
        "device_id": {"type": "string"},
        "connection_status": {"type": "string", "enum": ["CONNECTED", "DISCONNECTED"]},
        "is_current": {"type": "boolean", "const": true},
        "received_at": {"type": "string", "minLength": 1},
        "observation": {"$ref": "#/$defs/observation"}
      }
    },
    "status_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "android_schema_version",
        "device_id",
        "paired",
        "connection_status",
        "last_seen_at",
        "latest_observation_id",
        "latest_observation_version",
        "latest_availability"
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "android_schema_version": {"type": "string", "const": "1.0"},
        "device_id": {"type": "string"},
        "paired": {"type": "boolean"},
        "connection_status": {"type": "string", "enum": ["CONNECTED", "DISCONNECTED"]},
        "last_seen_at": {"type": ["string", "null"]},
        "latest_observation_id": {"type": ["string", "null"]},
        "latest_observation_version": {"type": ["integer", "null"]},
        "latest_availability": {"type": ["string", "null"]}
      }
    },
    "task_submit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "android_schema_version",
        "task_id",
        "device_id",
        "goal"
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "android_schema_version": {"type": "string", "const": "1.0"},
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "device_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "goal": {"type": "string", "minLength": 1},
        "source": {"type": "string"},
        "recovery_capability": {
          "type": "string",
          "enum": ["durable_action_journal_then_server_intent_then_effect_v1"]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "android_schema_version",
        "task_id",
        "action_id",
        "observation_id",
        "observation_version",
        "kind",
        "target_node_id",
        "target_node_label",
        "target_node_role",
        "expected_page_state",
        "source",
        "created_at"
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "android_schema_version": {"type": "string", "const": "1.0"},
        "task_id": {"type": "string"},
        "device_id": {"type": "string"},
        "session_id": {"type": "string"},
        "action_id": {"type": "string"},
        "observation_id": {"type": "string"},
        "observation_version": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "kind": {"type": "string", "enum": ["tap", "set_text", "long_press", "swipe", "coordinate_tap", "system_back"]},
        "target_node_id": {"type": "string"},
        "target_node_label": {"type": "string"},
        "target_node_role": {"type": "string"},
        "expected_page_state": {"type": "string"},
        "parameters": {"type": "object"},
        "coordinate_frame": {"type": "object"},
        "requires_screenshot": {"type": "boolean"},
        "before_screenshot_id": {"type": ["string", "null"]},
        "source": {"type": "string"},
        "created_at": {"type": "string"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "android_schema_version",
        "task_id",
        "receipt_id",
        "action_id",
        "device_id",
        "accepted",
        "outcome",
        "received_at"
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "android_schema_version": {"type": "string", "const": "1.0"},
        "task_id": {"type": "string"},
        "receipt_id": {"type": "string"},
        "action_id": {"type": "string"},
        "device_id": {"type": "string"},
        "accepted": {"type": "boolean"},
        "outcome": {"type": "string", "enum": ["EXECUTED", "REJECTED"]},
        "received_at": {"type": "string"},
        "error_code": {"type": ["string", "null"]},
        "error_message": {"type": ["string", "null"]},
        "observation_id": {"type": ["string", "null"]},
        "observation_version": {"type": ["integer", "null"]},
        "after_observation_id": {"type": ["string", "null"]},
        "after_observation_version": {"type": ["integer", "null"]},
        "after_screenshot_id": {"type": ["string", "null"]},
        "after_screenshot_missing_reason": {"type": ["string", "null"]},
        "deduplicated": {"type": "boolean"}
      }
    },
    "task_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "android_schema_version",
        "task_id",
        "device_id",
        "goal",
        "state",
        "action",
        "receipt",
        "verification",
        "failure",
        "control"
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "android_schema_version": {"type": "string", "const": "1.0"},
        "task_id": {"type": "string"},
        "device_id": {"type": "string"},
        "goal": {"type": "string"},
        "state": {"type": "string", "enum": ["RUNNING", "PAUSED", "SUCCEEDED", "FAILED", "CANCELLED"]},
        "action": {"type": ["object", "null"]},
        "next_action": {"type": ["object", "null"]},
        "receipt": {"type": ["object", "null"]},
        "verification": {"type": ["object", "null"]},
        "failure": {"type": ["object", "null"]},
        "control": {"type": ["object", "null"]},
        "phase": {"type": "string"},
        "before_observation_id": {"type": ["string", "null"]},
        "after_observation_id": {"type": ["string", "null"]},
        "before_screenshot_id": {"type": ["string", "null"]},
        "after_screenshot_id": {"type": ["string", "null"]},
        "before_visual": {"type": ["object", "null"]},
        "after_visual": {"type": ["object", "null"]},
        "action_result_unknown": {"type": "boolean"},
        "trace": {"type": "array"}
      }
    },
    "command_intent_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "device_session_id"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "device_session_id": {"type": "string", "minLength": 1}
      }
    },
    "command_intent_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "action_id", "device_session_id", "intent_recorded", "recovery_outcome"],
      "properties": {
        "task_id": {"type": "string"},
        "action_id": {"type": "string"},
        "device_session_id": {"type": "string"},
        "intent_recorded": {"type": "boolean", "const": true},
        "recovery_outcome": {"type": "string", "const": "UNKNOWN"}
      }
    },
    "device_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "phase", "receipt"],
      "properties": {
        "action_id": {"type": "string"},
        "phase": {"type": "string", "enum": ["PENDING", "RECEIPT_RECORDED"]},
        "receipt": {"anyOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]}
      }
    },
    "reconcile_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_session_id", "device_record"],
      "properties": {
        "device_session_id": {"type": "string", "minLength": 1},
        "device_record": {"anyOf": [{"$ref": "#/$defs/device_record"}, {"type": "null"}]}
      }
    },
    "recovery_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "task_id", "state", "phase", "reason", "eligible", "confirmed",
        "resume_token", "observation_version", "action_outcome", "action_id", "action_kind",
        "actual_effect", "independent_result", "device_session_id", "usage"
      ],
      "properties": {
        "format": {"type": "string", "const": "jev-android-recovery-v1"},
        "task_id": {"type": "string"},
        "state": {"type": "string", "enum": ["RUNNING", "PAUSED", "SUCCEEDED", "FAILED", "CANCELLED"]},
        "phase": {"type": "string", "enum": ["NOT_REQUIRED", "RECONCILIATION_REQUIRED", "READY_TO_RESUME", "RESUMED"]},
        "reason": {"type": ["string", "null"]},
        "eligible": {"type": "boolean"},
        "confirmed": {"type": "boolean"},
        "resume_token": {"type": ["string", "null"]},
        "observation_version": {"type": ["integer", "null"]},
        "action_outcome": {"type": ["string", "null"], "enum": ["EXECUTED", "NOT_EXECUTED", "UNKNOWN", null]},
        "action_id": {"type": ["string", "null"]},
        "action_kind": {"type": ["string", "null"]},
        "actual_effect": {"type": ["object", "null"]},
        "independent_result": {"type": ["object", "null"]},
        "device_session_id": {"type": ["string", "null"]},
        "usage": {"type": ["object", "null"]}
      }
    },
    "resume_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "resume_token", "observation_version", "device_session_id"],
      "properties": {
        "confirmed": {"type": "boolean", "const": true},
        "resume_token": {"type": "string", "minLength": 1},
        "observation_version": {"type": "integer", "minimum": 1},
        "device_session_id": {"type": "string", "minLength": 1},
        "model": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["provider", "endpoint", "model", "api_key", "max_steps", "max_requests", "max_tokens", "budget_cny"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "endpoint": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "api_key": {"type": "string", "minLength": 1},
            "max_steps": {"type": "integer", "minimum": 1},
            "max_requests": {"type": "integer", "minimum": 1},
            "max_tokens": {"type": "integer", "minimum": 1},
            "budget_cny": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "resume_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "recovery"],
      "properties": {
        "task": {"$ref": "#/$defs/task_status"},
        "recovery": {"$ref": "#/$defs/recovery_status"}
      }
    },
    "health_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_status", "persistence_status", "pending_reconciliation_count"],
      "properties": {
        "service_status": {"type": "string", "enum": ["ok", "degraded"]},
        "persistence_status": {"type": "string", "enum": ["enabled", "disabled"]},
        "pending_reconciliation_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
